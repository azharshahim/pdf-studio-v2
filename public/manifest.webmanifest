{
  "name": "PDF Studio — OCR & édition de PDF",
  "id": "/studio-pdf/",
  "short_name": "PDF Studio",
  "description": "Lecture, OCR français/anglais et édition de texte PDF, 100 % en local.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f6fa",
  "theme_color": "#4f46e5",
  "orientation": "any",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "productivity",
    "utilities"
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Document PDF",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "icons/pdf-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "icons/pdf-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "icons/pdf-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "icons/pdf-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "icons/pdf-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/pdf-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "Mes fichiers",
      "short_name": "Fichiers",
      "url": "./?open=files",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Photos en PDF",
      "short_name": "Photos",
      "url": "./?open=photos",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}